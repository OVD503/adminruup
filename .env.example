# Database and session security
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ruup_admin?schema=public"
SESSION_SECRET="replace-with-a-random-32-plus-character-secret"

# Firebase Authentication client configuration. Firebase API keys are public
# identifiers; do not place Firebase Admin SDK credentials in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-web-app-id"
# User IDs such as `superadmin` map to `superadmin@admins.example.com` in Firebase.
NEXT_PUBLIC_FIREBASE_USER_DOMAIN="admins.example.com"
# The initial Super Admin may be identified without a database role record.
# Prefer FIREBASE_SUPER_ADMIN_UID after obtaining the UID from Firebase Auth.
FIREBASE_SUPER_ADMIN_UID=""
FIREBASE_SUPER_ADMIN_EMAIL="superadmin@admins.example.com"

# First Super Admin. Used only by `npm run db:seed` to create the initial account.
SEED_SUPER_ADMIN_USER_ID="superadmin"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-initial-password"
SEED_SUPER_ADMIN_NAME="Super Admin"

# Cloudflare R2 PDF storage placeholders
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
